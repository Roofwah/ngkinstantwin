PORT=3000
NODE_ENV=development
# Public HTTPS URL for QR codes (/t/{token}). Optional on Railway if RAILWAY_PUBLIC_DOMAIN is set.
# On Render, set to https://your-service.onrender.com (or rely on RENDER_EXTERNAL_URL).
# Local phone testing (optional): http://YOUR_MAC_LAN_IP:5173  e.g. http://192.168.1.42:5173
BASE_URL=
# Vite dev port when auto-building phone QR links (default 5173)
# CLIENT_DEV_PORT=5173
DEMO_MODE=true
DATABASE_URL=
DATABASE_PATH=./data/instant-win.db
MOCK_SEED=00000000000000000001f4a9c8b7e6d9mockseed
ADMIN_PASSWORD=changeme

# Bird SMS (OTP). When all three are set, /api/otp/send uses Bird instead of demo code 123456.
# Required on Railway production for real SMS verification.
# AU uses the Channels API (AccessKey) — do not replace these with a bk_ key.
BIRD_ACCESS_KEY=
BIRD_WORKSPACE_ID=
BIRD_CHANNEL_ID=
# Force demo OTP even when Bird is configured (local testing only)
# OTP_DEMO_MODE=true

# Resend — internal winner email to ops/staff when someone instant-wins.
# Without RESEND_API_KEY the win still stands; email is logged only.
# Verify draw@status.turnstylehost.com is authorised in your Resend domain.
RESEND_API_KEY=
RESEND_FROM="PUK Instant Win <onboarding@resend.dev>"
WINNER_NOTIFY_EMAIL=chris@flowmarketing.com.au

# US SMS — newer Bird platform API (bk_… key from SMS onboarding). Separate from AU AccessKey.
# from must be your approved toll-free so OTP is not sent from Bird’s system sender.
BIRD_API_KEY=
BIRD_SMS_FROM_US=+18882134990

# NZ Bird SMS channel (optional; Channels API)
BIRD_CHANNEL_ID_NZ=
# Legacy US Channels UUID (unused when BIRD_API_KEY + BIRD_SMS_FROM_US are set)
BIRD_CHANNEL_ID_US=
