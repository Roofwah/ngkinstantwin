PORT=3000
NODE_ENV=development
# Public HTTPS URL for QR codes (/t/{token}). Optional on Railway if RAILWAY_PUBLIC_DOMAIN is set.
# On Render, set to https://your-service.onrender.com (or rely on RENDER_EXTERNAL_URL).
# Local phone testing (optional): http://YOUR_MAC_LAN_IP:5173  e.g. http://192.168.1.42:5173
BASE_URL=
# Vite dev port when auto-building phone QR links (default 5173)
# CLIENT_DEV_PORT=5173
DEMO_MODE=true
DATABASE_URL=
DATABASE_PATH=./data/instant-win.db
MOCK_SEED=00000000000000000001f4a9c8b7e6d9mockseed
ADMIN_PASSWORD=changeme

# Bird SMS (OTP). When all three are set, /api/otp/send uses Bird instead of demo code 123456.
# Required on Railway production for real SMS verification.
BIRD_ACCESS_KEY=
BIRD_WORKSPACE_ID=
BIRD_CHANNEL_ID=
# Force demo OTP even when Bird is configured (local testing only)
# OTP_DEMO_MODE=true

# Resend — internal winner email. Without RESEND_API_KEY the win still stands; email is logged.
RESEND_API_KEY=
RESEND_FROM="Cotswold Instant Win <onboarding@resend.dev>"
WINNER_NOTIFY_EMAIL=chris@flowmarketing.com.au
